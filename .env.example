# Models are served locally by LM Studio — start its server and load both.
# Defaults match the ids below, so this file can stay empty for a local setup.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=text-embedding-embeddinggemma-300m

# Only needed when LLM_BASE_URL points at a hosted, authenticated endpoint.
# LLM_API_KEY=

# --- generation hosted, embeddings local ------------------------------------
# EMBED_BASE_URL splits the embedder off the generation endpoint. Two reasons
# it exists: a gateway may serve /chat/completions and no /embeddings (this is
# true of OpenRouter), and the index's vectors came from one embedding model,
# so the embedder has to stay where that model is even when generation moves.
#
# The setup below runs generation, reranking and the ragas judge on OpenRouter
# while embeddings stay in LM Studio, against the index already on disk:
#
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=<your OpenRouter key>
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_BASE_URL=http://127.0.0.1:1234/v1
# LLM_RPM=60
#
# LLM_MODEL is deliberately the same id LM Studio served, so a run made this
# way stays comparable with the ones measured locally. LLM_RPM paces requests
# against a metered endpoint; 0 (the default) disables pacing.
# EMBED_API_KEY is only needed if the embedding host wants its own key — blank
# reuses LLM_API_KEY, which a local server ignores.
# EMBED_API_KEY=
#
# The judge follows the same split. Blank means: judge LLM from LLM_BASE_URL
# (or EVAL_BASE_URL), judge embeddings from EMBED_BASE_URL.
# EVAL_BASE_URL=
# EVAL_LLM_MODEL=
# EVAL_EMBED_BASE_URL=

# --- switches for the optional stages ---------------------------------------
# Each one is also a toggle in the Streamlit sidebar; this file sets what the
# UI starts from. Every other hyperparameter lives in `Settings`
# (rag/config.py) and is reachable from the sidebar.

# Hypothetical-question generation: `false` skips it and indexes chunks only.
# It costs one local generation call per chunk — the slow half of a build.
RAG_ENABLE_QUESTIONS=true

# Markdown cleaning: `false` chunks the raw extraction, link soup and all.
# RAG_ENABLE_CLEANING=true

# Answer composition: `false` retrieves without generating an answer.
# RAG_ENABLE_ANSWERS=true

# Query expansion: `false` searches only the question as typed. On, it costs one
# generation call per search, so searching is slower but finds passages worded
# differently from the query.
# RAG_ENABLE_QUERY_EXPANSION=true

# Reuse the extracted markdown in .cache: `false` re-extracts every build.
# RAG_USE_CACHE=true

# Skip the model server entirely and use word-overlap vectors (poor, but free).
# RAG_OFFLINE=false

# Optional: override the default source. Must be a PDF.
# RAG_SOURCE=data/ods-exercise-and-athletic-performance.pdf
