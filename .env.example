# Models are served locally by LM Studio — start its server and load both.
# Defaults match the ids below, so this file can stay empty for a local setup.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=text-embedding-embeddinggemma-300m

# Only needed when LLM_BASE_URL points at a hosted, authenticated endpoint.
# LLM_API_KEY=

# --- switches for the optional stages ---------------------------------------
# Each one is also a toggle in the Streamlit sidebar; this file sets what the
# UI starts from. Every other hyperparameter lives in `Settings`
# (rag/config.py) and is reachable from the sidebar.

# Hypothetical-question generation: `false` skips it and indexes chunks only.
# It costs one local generation call per chunk — the slow half of a build.
RAG_ENABLE_QUESTIONS=true

# Markdown cleaning: `false` chunks the raw extraction, link soup and all.
# RAG_ENABLE_CLEANING=true

# Answer composition: `false` retrieves without generating an answer.
# RAG_ENABLE_ANSWERS=true

# Reuse the extracted markdown in .cache: `false` re-extracts every build.
# RAG_USE_CACHE=true

# Skip the model server entirely and use word-overlap vectors (poor, but free).
# RAG_OFFLINE=false

# Optional: override the default source (local .html path or URL)
# RAG_SOURCE=/path/to/Dietary Supplements for Exercise and Athletic Performance.html
