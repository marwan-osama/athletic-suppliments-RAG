          <mxGeometry x="40" y="168" width="620" height="52" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-c5" value="hits: some chunk rows, some question rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="236" width="620" height="52" as="geometry" />
