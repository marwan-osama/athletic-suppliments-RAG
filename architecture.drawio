          <mxGeometry x="630" y="100" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-c6" value="cited answer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;[1], [2] …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="165" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-answer-c3" target="page-answer-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-answer-c4" target="page-answer-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-answer-c5" target="page-answer-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-c10" value="&lt;b&gt;the prompt, in full&lt;/b&gt;&lt;br&gt;&lt;br&gt;Answer the question using ONLY the numbered sources below. Cite the sources you use as [1], [2], and so on. If the sources do not contain the answer, say so plainly.&lt;br&gt;&lt;br&gt;Question: {question}&lt;br&gt;&lt;br&gt;Sources:&lt;br&gt;{sources}&lt;br&gt;&lt;br&gt;Answer:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="525" height="190" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-note11" value="&lt;b&gt;The context budget is spent in rank order.&lt;/b&gt; Sources are added until answer_max_context_chars (default 8,000) runs out, and the last one in is truncated rather than dropped — so a lower-ranked chunk can be cut off, but the top result is always whole.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reasoning comes out of max_tokens too&lt;/b&gt;, which is why the budget is generous. A model that spends it all thinking returns empty content, and LLMClient says so rather than returning an empty answer." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="220" width="505" height="190" as="geometry" />
        </mxCell>
        <mxCell id="page-answer-note12" value="&lt;b&gt;Optional on purpose.&lt;/b&gt; Retrieval quality is judged by reading the chunks, which the Ask tab shows without generating anything — so the answer is an extra call you opt into. Switched off, the pipeline still retrieves and the button explains why it is disabled; running offline, the same call returns a notice instead of a placeholder that could be mistaken for an answer." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1085" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-eval" name="12 · Evaluation — a run">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-eval-t1" value="Evaluation — grading the pipeline, not a file" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-t2" value="evaluation/ · needs ragas, imported only when a run starts" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c3" value="golden set&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;question + reference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="175" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c4" value="harness&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;collect()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="255" y="100" width="175" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c5" value="&lt;b&gt;RAGPipeline&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;search() · answer()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c6" value="records&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;+ contexts + answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c7" value="judge&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;4 ragas metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="100" width="195" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e8" value="asks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-c3" target="page-eval-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e9" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-c4" target="page-eval-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e10" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-c5" target="page-eval-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e11" value="grades" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-c6" target="page-eval-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c12" value="abandoned: contexts and answer read straight from the file — the pipeline never runs, so no setting can move a score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="210" width="635" height="44" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-eval-c3" target="page-eval-c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;dashed=1;strokeColor=#999999;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="page-eval-c12" target="page-eval-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-t15" value="four metrics, two stages — a failure names the stage to look at" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c16" value="&lt;b&gt;context_recall&lt;/b&gt; &amp;nbsp; did retrieval find the evidence the reference needs?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="525" height="50" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c17" value="&lt;b&gt;context_precision&lt;/b&gt; &amp;nbsp; are the chunks returned actually about the question?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="525" height="50" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c18" value="&lt;b&gt;faithfulness&lt;/b&gt; &amp;nbsp; is the answer grounded in those chunks?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="525" height="50" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-c19" value="&lt;b&gt;answer_relevancy&lt;/b&gt; &amp;nbsp; does the answer address the question asked?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="525" height="50" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-note20" value="&lt;b&gt;Measured, same questions, only top-k changed:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;top-k 5&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;recall 0.730 · precision 0.963&lt;br&gt;&amp;nbsp;&amp;nbsp;top-k 10&amp;nbsp;→&amp;nbsp;&amp;nbsp;recall 0.944 · precision 0.863&lt;br&gt;&lt;br&gt;That trade-off is the whole point of running the pipeline live. On the abandoned path both rows are identical." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-note21" value="&lt;b&gt;It refuses rather than reporting nothing.&lt;/b&gt; An empty index, a switched-off server, or answering disabled would each still produce a full set of confident numbers — about a placeholder. check_ready() fails first, naming the fix.&lt;br&gt;&lt;br&gt;Evaluation settings sit outside index_key: grading reads an index, it can never fork or rebuild one." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="460" width="505" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-eval-data" name="13 · Evaluation — the data">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-eval-data-t1" value="Where every input to a score comes from" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-t2" value="one source document, two things drawn from it" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="310" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c3" value="&lt;b&gt;NIH ODS fact sheet&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Dietary Supplements for Exercise&lt;br&gt;and Athletic Performance&lt;br&gt;180,095 chars of markdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c4" value="&lt;b&gt;the corpus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;cleaned → chunked → embedded&lt;br&gt;288 chunks + 864 questions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c5" value="&lt;b&gt;the golden set&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;3 × question + reference answer&lt;br&gt;hand-written, grounded in the page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e6" value="steps 1–6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-eval-data-c3" target="page-eval-data-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e7" value="read by a human" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-eval-data-c3" target="page-eval-data-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c8" value="&lt;b&gt;retrieved at run time&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;contexts + answer, from search() and answer()&lt;br&gt;never stored in the file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="365" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e9" value="queried with the golden questions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-data-c4" target="page-eval-data-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="page-eval-data-c5" target="page-eval-data-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c11" value="&lt;b&gt;the judge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;a second model, gpt-oss-20b by default&lt;br&gt;compares the two&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="365" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-eval-data-c8" target="page-eval-data-c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-e13" value="reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-eval-data-c5" target="page-eval-data-c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-note14" value="&lt;b&gt;The golden set holds only the question and the reference answer.&lt;/b&gt; Contexts and answers are outputs — the things being graded — so storing them in the file would mean grading the file: every metric would read the same at any chunk size, top-k or embedder, and a regression could not move it. The imported branch worked that way, which is why the harness was added.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reference answers must be traceable to the page.&lt;/b&gt; context_recall asks whether retrieval found the evidence the reference relies on — so a reference asserting something the corpus does not contain fails for a reason that has nothing to do with retrieval. The retriever cannot find what was never written." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1085" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-t15" value="all three shipped references failed that test, and were regrounded" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c16" value="&lt;b&gt;creatine&lt;/b&gt; &amp;nbsp;cited a “meta-analysis of 22 studies” with 8% and 14% figures — no such meta-analysis is on the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1085" height="44" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c17" value="&lt;b&gt;caffeine&lt;/b&gt; &amp;nbsp;gave 3–6 mg/kg as the recommendation; the page says 2–6, and attributes 3–6 to the ISSN for endurance specifically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="512" width="1085" height="44" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-c18" value="&lt;b&gt;iron&lt;/b&gt; &amp;nbsp;claimed deficiency without anaemia impairs performance and that ACSM recommends screening — the page says the evidence is &lt;i&gt;conflicting&lt;/i&gt;, and that ACSM advises &lt;i&gt;against&lt;/i&gt; routine supplementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="564" width="1085" height="44" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-note19" value="&lt;b&gt;Verified mechanically.&lt;/b&gt; A six-word window slid across every sentence of every reference against the indexed corpus: lowest overlap 54%, most above 80%. Keep that property when adding questions." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="page-eval-data-note20" value="&lt;b&gt;What regrounding was worth&lt;/b&gt;, pipeline unchanged:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;context recall&amp;nbsp;&amp;nbsp;&amp;nbsp;0.556 → &lt;b&gt;0.730&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;answer relevancy&amp;nbsp;0.891 → &lt;b&gt;0.922&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two of three samples went from failing to passing." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="630" width="505" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-ui" name="14 · Streamlit UI">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-ui-t1" value="The UI — one loop for tuning, one for judging" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-t2" value="sidebar · one section per stage, in the order the stages run" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c3" value="&lt;b&gt;📥 Source &amp;amp; fetching&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;source · cache · base URL · min chars&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🧹 Cleaning&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;bypass + 5 flags + dropped sections&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;✂️ Chunking&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;size · overlap · merge · prefix · cap&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;❓ Question augmentation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;bypass · count · workers · temp · tokens&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🔢 Embedding&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;server bypass · model · batch · prefixes&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🗄️ Index storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;path · prefix · upsert size&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🔀 Query expansion&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;bypass · phrasings · temp · boost · cap&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🔎 Retrieval&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;top-k · one per chunk · overfetch&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;💬 Answering&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;bypass · temp · tokens · context budget&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🔌 Model server&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;URL · model · key · rate · timeout · retries&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🩺 Diagnostics&lt;/b&gt; &amp;nbsp; &lt;b&gt;📊 Evaluation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="460" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c4" value="&lt;b&gt;Ask&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;a question or a saved set · every result shows similarity, what matched, its heading path and full text · judge each one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="100" width="735" height="76" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c5" value="&lt;b&gt;Chunks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;what the current settings produce, before any embedding is paid for · size stats · quality flags · the projected cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="192" width="735" height="76" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c6" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;precision per question · best rank that actually hit · export the judgements as JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="284" width="735" height="76" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c7" value="&lt;b&gt;Evaluate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;run the golden set · four scores against the threshold · per-question table · what to try · download the report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="376" width="735" height="76" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-c8" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;rows by type · collections on disk · stages in force · effective settings · pipeline log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="468" width="735" height="76" as="geometry" />
        </mxCell>
        <mxCell id="page-ui-note9" value="&lt;b&gt;Every one of the 61 settings has a control&lt;/b&gt;, and a test walks app.py to prove it — a new field on Settings without a widget fails the suite.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nothing here is destructive.&lt;/b&gt; Settings that change the stored vectors move you to a collection of their own, so you can compare configurations and move back to one you already built. Settings that do not are pushed onto the live stages by RAGPipeline.apply(), so moving a retrieval slider never reopens the database." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1085" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-chunking" name="6 · Chunkization">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-title" value="Chunkization — MarkdownChunker, step by step" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-s1" value="1 · sections before size — cut at every heading, so a chunk never spans two supplements" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-in" value="&lt;b&gt;cleaned markdown&lt;/b&gt;&lt;br&gt;&lt;br&gt;# Dietary Supplements for Exercise…&lt;br&gt;## Selected Ingredients in Dietary…&lt;br&gt;### Creatine&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;Creatine is one of the most thoroughly&lt;br&gt;studied and widely used dietary…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-stack" value="&lt;b&gt;heading stack&lt;/b&gt;&lt;br&gt;&lt;br&gt;H1 Dietary Supplements…&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;dropped&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;identical on every chunk&lt;/font&gt;&lt;br&gt;&lt;br&gt;H2 Selected Ingredients…&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;trimmed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;path would exceed 80 chars&lt;/font&gt;&lt;br&gt;&lt;br&gt;H3 Creatine&amp;nbsp;&amp;nbsp; H4 Efficacy&amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;kept&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-crumb" value="&lt;b&gt;section&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creatine &amp;gt; Efficacy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="130" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p6-in" target="p6-stack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p6-stack" target="p6-crumb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-s2" value="2 · the section path is the chunk's first line — and it comes out of the size budget" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar" value="chunk_size = 600 chars" style="text;html=1;fontSize=11;align=left;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar1" value="heading path&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;≤ chunk_size / 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar2" value="body from the splitter&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;chunk_size − prefix&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="340" width="410" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6-barnote" value="Reserving the prefix means a chunk &lt;b&gt;can never exceed the size you asked for&lt;/b&gt; — the promise ChunkInspector then checks (0 oversized out of 288). A heading path longer than its share is truncated with an ellipsis rather than starving the body." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="315" width="450" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6-s3" value="3 · split the body — try the widest separator that fits, then fall back" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-l1" value="blank line&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;paragraph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l2" value="newline&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l3" value="space&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;word&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l4" value="hard cut&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;last resort&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-le1" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l1" target="p6-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-le2" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l2" target="p6-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-le3" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l3" target="p6-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-lnote" value="Sections are split independently, so &lt;b&gt;overlap never bleeds across a heading&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="470" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-s4" value="4 · overlap between neighbours, and small leftovers folded in" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-ov1" value="chunk n" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-ov2" value="chunk n + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=60;" vertex="1" parent="1">
          <mxGeometry x="240" y="650" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-ovmark" value="&lt;font color=&quot;#b85450&quot;&gt;overlap&lt;br&gt;100&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="595" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6-mergenote" value="&lt;b&gt;Folding small pieces&lt;/b&gt;&lt;br&gt;&lt;br&gt;A piece shorter than min_chars joins the previous one — but &lt;b&gt;only if the result still fits&lt;/b&gt; the budget, so tidying leftovers can never break the size promise. A piece with no letters or digits is dropped, and a heading with no prose beneath it never becomes a chunk of its own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="595" width="530" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-out" value="&lt;b&gt;Chunk&lt;/b&gt;&amp;nbsp;&amp;nbsp; id c0042-1f3a9b7c&amp;nbsp; ·&amp;nbsp; index 42&amp;nbsp; ·&amp;nbsp; section &quot;Creatine &amp;gt; Efficacy&quot;&lt;br&gt;&lt;br&gt;Creatine &amp;gt; Efficacy&lt;br&gt;&lt;br&gt;Creatine is one of the most thoroughly studied and widely used dietary supplements…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1090" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-final" value="&lt;b&gt;id is a hash of the text&lt;/b&gt;, not a uuid — so re-chunking the same document upserts the same rows instead of duplicating them.&amp;nbsp;&amp;nbsp; &lt;b&gt;Result at 600 / 100:&lt;/b&gt; 288 chunks · min 111 · median 494 · max 600 · 0 oversized · 0 heading-only." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1090" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
