        </mxCell>
        <mxCell id="page-expansion-c40" value="3 ▼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="410" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-expansion-note41" value="&lt;b&gt;similarity is never overwritten.&lt;/b&gt; It stays what the embedder returned, so a result can never claim a closer match than it made. Agreement goes to &lt;i&gt;boost&lt;/i&gt;, and only &lt;i&gt;score&lt;/i&gt; = similarity + boost sorts the list — +0.05 per extra phrasing, capped at +0.15.&lt;br&gt;&lt;br&gt;Row 2 is the weaker match and still outranks row 3." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="page-expansion-note42" value="&lt;b&gt;One vote per phrasing, not per row.&lt;/b&gt; A chunk can match through itself and three of its own hypothetical questions — four rows, one phrasing, one vote. Counting rows would boost any chunk that had questions, even with expansion switched off.&lt;br&gt;&lt;br&gt;Costs one generation call per &lt;i&gt;search&lt;/i&gt;. Builds are untouched." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="505" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
