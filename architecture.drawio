        </mxCell>
        <mxCell id="page-architecture-e22" value="embed · generate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-architecture-c8" target="page-architecture-c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-architecture-e23" value="upsert · query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-architecture-c8" target="page-architecture-c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-architecture-e24" value="judge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;strokeColor=#d79b00;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-architecture-c9" target="page-architecture-c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-architecture-note25" value="&lt;b&gt;One network boundary.&lt;/b&gt; LLMClient in rag/llm.py is the only code that opens a connection — retries, optional pacing and error messages are written once and every stage inherits them.&lt;br&gt;&lt;br&gt;&lt;b&gt;One config object.&lt;/b&gt; A field that is not on Settings cannot be reached from the UI, and a test fails if a field has no control." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="page-architecture-note26" value="&lt;b&gt;Nothing here needs a key.&lt;/b&gt; LM Studio serves locally; api_key exists for pointing base_url at a hosted gateway.&lt;br&gt;&lt;br&gt;&lt;b&gt;Switch the server off&lt;/b&gt; and HashEmbedder substitutes word-overlap vectors, so the UI and the tests still run — poorly, but they run." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="505" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
