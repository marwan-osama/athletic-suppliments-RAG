  <diagram id="page-text" name="3 · Cleaning &amp; chunking">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="What the text goes through" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-t1" value="&lt;b&gt;1 · raw extraction&lt;/b&gt;&lt;br&gt;&lt;br&gt;Have a question? [Ask ODS](https://ods…)&lt;br&gt;&lt;br&gt;###&amp;nbsp; &amp;nbsp; &amp;nbsp; ← the name never made it&lt;br&gt;&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;…no such benefits [[53](https://ods…),&lt;br&gt;[56](https://ods…)]." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3-t2" value="&lt;b&gt;2 · cleaned&lt;/b&gt;&lt;br&gt;&lt;br&gt;### HMB&amp;nbsp; &amp;nbsp; ← named from its first sentence&lt;br&gt;&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;…no such benefits." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-t3" value="&lt;b&gt;3 · chunk&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c&lt;br&gt;&lt;br&gt;HMB &amp;gt; Efficacy&lt;br&gt;&lt;br&gt;Although studies have investigated HMB for&lt;br&gt;two decades, they have used substantially&lt;br&gt;different periods of supplementation…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-a1" value="MarkdownCleaner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=12;fontStyle=1;" edge="1" parent="1" source="p3-t1" target="p3-t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-a2" value="MarkdownChunker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=12;fontStyle=1;" edge="1" parent="1" source="p3-t2" target="p3-t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-c1" value="&lt;b&gt;MarkdownCleaner&lt;/b&gt;&lt;br&gt;&lt;br&gt;· unwrap links, drop citation markers&lt;br&gt;· drop nav lines and the reference list&lt;br&gt;· strip &amp;lt;sub&amp;gt; tags, tidy whitespace&lt;br&gt;· &lt;b&gt;name empty headings&lt;/b&gt; from the first&lt;br&gt;&amp;nbsp; sentence of the section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="530" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3-c2" value="&lt;b&gt;MarkdownChunker&lt;/b&gt;&lt;br&gt;&lt;br&gt;· split at headings first — no chunk spans two supplements&lt;br&gt;· prefix each chunk with its heading path&lt;br&gt;· fold fragments into neighbours, never past chunk_size&lt;br&gt;· id from a hash of the text, so re-indexing upserts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-stats" value="&lt;b&gt;Same file, same 600 / 100 settings&lt;/b&gt;&lt;br&gt;&lt;br&gt;463 → &lt;b&gt;288&lt;/b&gt; chunks&amp;nbsp; ·&amp;nbsp; 35 → &lt;b&gt;0&lt;/b&gt; chunks under 100 chars&lt;br&gt;smallest 3 → &lt;b&gt;111&lt;/b&gt; chars&amp;nbsp; ·&amp;nbsp; 43 → &lt;b&gt;1&lt;/b&gt; flagged as suspect&lt;br&gt;15 → &lt;b&gt;95&lt;/b&gt; distinct named sections" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=10;spacingTop=8;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="540" width="530" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-index" name="4 · Index &amp; retrieval">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title" value="What sits in the index, and how a search resolves" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-lbl" value="one collection" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#999999;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p4-r1" value="&lt;b&gt;chunk row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c&lt;br&gt;document: &quot;HMB &amp;gt; Efficacy … &quot;&lt;br&gt;type=chunk · section · chunk_index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-r2" value="&lt;b&gt;question row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c-q0&lt;br&gt;document: &quot;What is HMB?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4-r3" value="&lt;b&gt;question row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c-q1&lt;br&gt;document: &quot;Is HMB safe for older adults?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4-pe1" value="parent_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-r2" target="p4-r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-pe2" value="parent_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-r3" target="p4-r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note1" value="Question rows hold &lt;b&gt;a pointer, not a copy&lt;/b&gt; of the chunk text.&lt;br&gt;One copy of the document, nothing to go stale." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-f1" value="your question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f2" value="embed as &quot;query: …&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="175" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f3" value="cosine search · over-fetch top-k × 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="250" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f4" value="hits: some chunks, some questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="325" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f5" value="collapse per parent_id — keep the best score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f6" value="resolve parent text — one lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="475" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-f7" value="&lt;b&gt;top-k chunks&lt;/b&gt; + similarity + what matched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="550" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f1" target="p4-f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f2" target="p4-f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f3" target="p4-f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f4" target="p4-f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f5" target="p4-f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p4-f6" target="p4-f7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-fe7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="p4-r1" target="p4-f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note2" value="&lt;b&gt;Why collapse:&lt;/b&gt; without it one passage fills every top-k slot through its own generated questions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Collection name carries the recipe:&lt;/b&gt;&amp;nbsp; ods_health_facts__llamanemotro_c600_o100_q3_m80_s1&lt;br&gt;model · chunk size · overlap · questions · merge threshold · heading prefix — so changing a setting builds a separate index instead of poisoning the old one." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1020" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-ui" name="5 · Streamlit UI">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-title" value="The UI — a loop for tuning retrieval and judging it" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-side" value="&lt;b&gt;Sidebar&lt;/b&gt;&lt;br&gt;&lt;br&gt;source · file or URL&lt;br&gt;&lt;br&gt;&lt;b&gt;chunk size&lt;/b&gt;&lt;br&gt;&lt;b&gt;overlap&lt;/b&gt;&lt;br&gt;merge threshold&lt;br&gt;heading prefix on/off&lt;br&gt;&lt;br&gt;&lt;b&gt;top-k&lt;/b&gt;&lt;br&gt;one result per chunk&lt;br&gt;questions per chunk&lt;br&gt;&lt;br&gt;[ Build index ]&amp;nbsp; [ Rebuild ]&lt;br&gt;&lt;br&gt;rows indexed · 288" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="460" as="geometry" />
        </mxCell>
        <mxCell id="p5-ask" value="&lt;b&gt;Ask&lt;/b&gt;&lt;br&gt;&lt;br&gt;ask one question, or keep a question set&lt;br&gt;and run one — or all of them&lt;br&gt;&lt;br&gt;every result shows:&lt;br&gt;· similarity&lt;br&gt;· chunk match or question match&lt;br&gt;· heading path&lt;br&gt;· the full chunk, exactly as indexed&lt;br&gt;&lt;br&gt;mark it relevant / not relevant, add a note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="390" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p5-chunks" value="&lt;b&gt;Chunks&lt;/b&gt;&lt;br&gt;&lt;br&gt;the chunks your current settings produce —&lt;br&gt;&lt;b&gt;before any embedding is paid for&lt;/b&gt;&lt;br&gt;&lt;br&gt;· size stats and quality flags&lt;br&gt;· filter by text or section&lt;br&gt;· estimated API requests and minutes&lt;br&gt;· download every chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="80" width="380" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p5-review" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;&lt;br&gt;· how many chunks judged, how many relevant&lt;br&gt;· precision per question&lt;br&gt;· best rank that actually hit&lt;br&gt;· export the judgements as JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="325" width="390" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p5-index" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;&lt;br&gt;· rows by type — chunks vs questions&lt;br&gt;· every collection on disk&lt;br&gt;· models in use and the pacing&lt;br&gt;· pipeline log, including retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="325" width="380" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p5-loop" value="tune → look at the chunks → search → judge → tune again" style="text;html=1;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="555" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-note" value="&lt;b&gt;Everything but the source is free to change.&lt;/b&gt; Chunk settings are part of the collection name, so moving a slider builds a separate index and moving it back reuses the one you already built. The Chunks tab is the cheap half of the loop: it re-chunks on every slider move without calling the API at all." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1090" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-chunking" name="6 · Chunkization">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-title" value="Chunkization — MarkdownChunker, step by step" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-s1" value="1 · sections before size — cut at every heading, so a chunk never spans two supplements" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-in" value="&lt;b&gt;cleaned markdown&lt;/b&gt;&lt;br&gt;&lt;br&gt;# Dietary Supplements for Exercise…&lt;br&gt;## Selected Ingredients in Dietary…&lt;br&gt;### Creatine&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;Creatine is one of the most thoroughly&lt;br&gt;studied and widely used dietary…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-stack" value="&lt;b&gt;heading stack&lt;/b&gt;&lt;br&gt;&lt;br&gt;H1 Dietary Supplements…&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;dropped&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;identical on every chunk&lt;/font&gt;&lt;br&gt;&lt;br&gt;H2 Selected Ingredients…&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;trimmed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;path would exceed 80 chars&lt;/font&gt;&lt;br&gt;&lt;br&gt;H3 Creatine&amp;nbsp;&amp;nbsp; H4 Efficacy&amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;kept&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-crumb" value="&lt;b&gt;section&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creatine &amp;gt; Efficacy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="130" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p6-in" target="p6-stack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p6-stack" target="p6-crumb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-s2" value="2 · the section path is the chunk's first line — and it comes out of the size budget" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar" value="chunk_size = 600 chars" style="text;html=1;fontSize=11;align=left;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar1" value="heading path&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;≤ chunk_size / 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6-bar2" value="body from the splitter&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;chunk_size − prefix&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="340" width="410" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6-barnote" value="Reserving the prefix means a chunk &lt;b&gt;can never exceed the size you asked for&lt;/b&gt; — the promise ChunkInspector then checks (0 oversized out of 288). A heading path longer than its share is truncated with an ellipsis rather than starving the body." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="315" width="450" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6-s3" value="3 · split the body — try the widest separator that fits, then fall back" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-l1" value="blank line&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;paragraph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l2" value="newline&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l3" value="space&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;word&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-l4" value="hard cut&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;last resort&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="470" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-le1" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l1" target="p6-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-le2" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l2" target="p6-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-le3" value="still too big" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="p6-l3" target="p6-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-lnote" value="Sections are split independently, so &lt;b&gt;overlap never bleeds across a heading&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="470" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-s4" value="4 · overlap between neighbours, and small leftovers folded in" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6-ov1" value="chunk n" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-ov2" value="chunk n + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=60;" vertex="1" parent="1">
          <mxGeometry x="240" y="650" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-ovmark" value="&lt;font color=&quot;#b85450&quot;&gt;overlap&lt;br&gt;100&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="595" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6-mergenote" value="&lt;b&gt;Folding small pieces&lt;/b&gt;&lt;br&gt;&lt;br&gt;A piece shorter than min_chars joins the previous one — but &lt;b&gt;only if the result still fits&lt;/b&gt; the budget, so tidying leftovers can never break the size promise. A piece with no letters or digits is dropped, and a heading with no prose beneath it never becomes a chunk of its own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="595" width="530" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-out" value="&lt;b&gt;Chunk&lt;/b&gt;&amp;nbsp;&amp;nbsp; id c0042-1f3a9b7c&amp;nbsp; ·&amp;nbsp; index 42&amp;nbsp; ·&amp;nbsp; section &quot;Creatine &amp;gt; Efficacy&quot;&lt;br&gt;&lt;br&gt;Creatine &amp;gt; Efficacy&lt;br&gt;&lt;br&gt;Creatine is one of the most thoroughly studied and widely used dietary supplements…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1090" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-final" value="&lt;b&gt;id is a hash of the text&lt;/b&gt;, not a uuid — so re-chunking the same document upserts the same rows instead of duplicating them.&amp;nbsp;&amp;nbsp; &lt;b&gt;Result at 600 / 100:&lt;/b&gt; 288 chunks · min 111 · median 494 · max 600 · 0 oversized · 0 heading-only." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1090" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
