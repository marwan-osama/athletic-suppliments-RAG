        <mxCell id="page-pipeline-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-pipeline-c21" target="page-pipeline-c22">
