        </mxCell>
        <mxCell id="page-modules-note34" value="&lt;b&gt;Every stage is a callable object&lt;/b&gt; — it has run(), __call__(), and composes with the | operator:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;chunks = (SourceFetcher() | MarkdownCleaner() | MarkdownChunker(600, 100))(source)&lt;/font&gt;&lt;br&gt;&lt;br&gt;Identity() is the no-op stage, which is how an optional step is bypassed without anything downstream needing a None check." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="596" width="1085" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
