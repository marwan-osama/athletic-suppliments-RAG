        <mxCell id="p6-c6" value="3&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;▼&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-swap" value="&lt;b&gt;0.701 is the weaker match&lt;/b&gt; — but two phrasings agreed on it and only one on Ribose, so it ranks above." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-note1" value="&lt;b&gt;similarity is never overwritten.&lt;/b&gt; It stays what the embedder returned,&lt;br&gt;so a result can never claim a closer match than it made. Agreement goes&lt;br&gt;to &lt;i&gt;boost&lt;/i&gt;, and only &lt;i&gt;score&lt;/i&gt; = similarity + boost sorts the list.&lt;br&gt;&lt;br&gt;+0.05 per extra phrasing, capped at +0.15 — both settings." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="510" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-note2" value="&lt;b&gt;One vote per phrasing, not per row.&lt;/b&gt; A chunk can match through itself &lt;i&gt;and&lt;/i&gt; three of its own hypothetical questions — four rows, one phrasing, one vote. Counting rows instead would boost any chunk that had questions, even with expansion switched off.&lt;br&gt;&lt;br&gt;&lt;b&gt;Query-time only.&lt;/b&gt; None of this changes what is stored, so no setting here forks a collection or invalidates an index. The cost is one generation call per &lt;i&gt;search&lt;/i&gt; — builds are untouched, searches get slower. Off (or offline), the expander returns the query alone and every result reads matches = 1, boost = 0, score = similarity." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="980" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
