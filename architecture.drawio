        </mxCell>
        <mxCell id="page-pipeline-e27" value="cosine search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-pipeline-c13" target="page-pipeline-c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-pipeline-note28" value="&lt;b&gt;The build is the slow half.&lt;/b&gt; 288 chunks embed in about 8 seconds; generating 3 questions for each takes about 4 minutes on this machine, one call per chunk.&lt;br&gt;&lt;br&gt;Turn questions off and a build is seconds. The Chunks tab shows the estimate for whatever settings are set, before anything is spent." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="page-pipeline-note29" value="&lt;b&gt;Optional stages, in order:&lt;/b&gt; the extraction cache, cleaning, question generation, query expansion, answering, and the model server itself.&lt;br&gt;&lt;br&gt;Each has a switch in Settings and a toggle in the sidebar. Bypassing one that changes the stored vectors moves you to a different collection rather than corrupting the one you have." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="505" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
