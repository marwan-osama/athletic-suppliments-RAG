        </mxCell>
        <mxCell id="p1-note1" value="&lt;b&gt;OpenRouterClient&lt;/b&gt; is the only code that calls the API.&lt;br&gt;Retries, 20 requests/minute pacing, clear errors — written once.&lt;br&gt;&lt;br&gt;embeddings · nvidia/llama-nemotron-embed-vl-1b-v2:free&lt;br&gt;generation · nvidia/nemotron-nano-9b-v2:free" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-note2" value="&lt;b&gt;No API key?&lt;/b&gt; HashEmbedder substitutes word-overlap vectors,&lt;br&gt;so the whole pipeline and UI still run offline — poorly, but they run.&lt;br&gt;&lt;br&gt;&lt;b&gt;Prefixes matter.&lt;/b&gt; The embedding model is asymmetric: documents&lt;br&gt;go in as &quot;passage: …&quot;, searches as &quot;query: …&quot;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="430" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
