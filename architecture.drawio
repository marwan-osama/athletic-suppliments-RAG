  <diagram id="page-fetch" name="3 · Step 1 — Fetch">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-fetch-t1" value="Fetch — one HTML page in, markdown out" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-t2" value="SourceFetcher · fetching.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c3" value="source&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;a local .html file&lt;br&gt;or an http(s) URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c4" value="cache hit?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;.cache/&amp;lt;slug&amp;gt;.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c5" value="trafilatura.extract&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;output_format=markdown&lt;br&gt;tables and links kept&lt;br&gt;favor_recall=True&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c6" value="length check&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;≥ fetch_min_chars&lt;br&gt;default 1,000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c7" value="markdown&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;180,095 chars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-c8" value="ValueError&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;“content was lost”&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-fetch-c3" target="page-fetch-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e10" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-fetch-c4" target="page-fetch-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-fetch-c5" target="page-fetch-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e12" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-fetch-c6" target="page-fetch-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e13" value="too short" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-fetch-c6" target="page-fetch-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-e14" value="hit — no extraction, no download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-fetch-c4" target="page-fetch-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-note15" value="&lt;b&gt;Why the length check.&lt;/b&gt; A saved page whose wrapper trafilatura does not recognise extracts as a few hundred characters of navigation. Nothing downstream would fail — you would simply index a nearly empty document and wonder why retrieval was poor. Failing loudly here is cheaper than debugging it at the far end." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-fetch-note16" value="&lt;b&gt;The cache is the bypass.&lt;/b&gt; use_cache=False re-extracts on every build, and re-downloads when the source is a URL.&lt;br&gt;&lt;br&gt;Extraction is the slow part of this stage and its output is deterministic, so the cache is on by default and the markdown is kept as a plain file you can read." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="505" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-clean" name="4 · Step 2 — Clean">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-clean-t1" value="Clean — what the extraction has to lose" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-t2" value="MarkdownCleaner · preprocessing.py · optional (enable_cleaning)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-c3" value="&lt;b&gt;1 · raw extraction&lt;/b&gt;&lt;br&gt;&lt;br&gt;Have a question? [Ask ODS](https://ods.od.nih.gov/contact)&lt;br&gt;&lt;br&gt;###&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;← the supplement name never made it&lt;br&gt;&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;Studies have investigated HMB [[112](https://ods…),[113](https://ods…)] for two decades…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-c4" value="&lt;b&gt;2 · cleaned&lt;/b&gt;&lt;br&gt;&lt;br&gt;### HMB&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;← named from its first sentence&lt;br&gt;&lt;br&gt;#### Efficacy&lt;br&gt;&lt;br&gt;Studies have investigated HMB for two decades…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-e5" value="MarkdownCleaner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="page-clean-c3" target="page-clean-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-c6" value="&lt;b&gt;five operations, each with its own switch&lt;/b&gt;&lt;br&gt;&lt;br&gt;· &lt;b&gt;strip_links&lt;/b&gt; — [label](url) → label, repeated until stable&lt;br&gt;· &lt;b&gt;strip_citations&lt;/b&gt; — drop [112] reference markers&lt;br&gt;· &lt;b&gt;drop_boilerplate&lt;/b&gt; — short nav lines: “Ask ODS”, “Back to top”&lt;br&gt;· &lt;b&gt;drop_sections&lt;/b&gt; — the whole references list and disclaimer&lt;br&gt;· &lt;b&gt;name_empty_headings&lt;/b&gt; — a bare ### renamed from the sentence below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="525" height="190" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-note7" value="&lt;b&gt;Why naming headings matters most.&lt;/b&gt; On this page every supplement heading extracts as a bare ###, because the name lives in an element trafilatura discards. Left alone, each subsection reads only “Efficacy” or “Safety” and the passage no longer says which supplement it is about — so a chunk about HMB and one about betaine become indistinguishable to the embedder.&lt;br&gt;&lt;br&gt;The first sentence of a section always opens with the name (“HMB is a metabolite of…”), which is where it is recovered from." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="525" height="170" as="geometry" />
        </mxCell>
        <mxCell id="page-clean-note8" value="&lt;b&gt;Bypassing it&lt;/b&gt; hands the raw extraction straight to the chunker. Worth doing once: 451 chunks instead of 288, 18 sections instead of 95, link-heavy flags across the top of the document, and URLs sitting inside the indexed text. That difference is what the cleaner is buying." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1085" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-chunk" name="5 · Step 3 — Chunk">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-chunk-t1" value="Chunk — splitting so a passage still says what it is about" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-t2" value="MarkdownChunker · chunking.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c3" value="cleaned markdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c4" value="split at headings&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;a chunk never spans&lt;br&gt;two supplements&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c5" value="recursive split&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;size − heading path&lt;br&gt;paragraph → line → word&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c6" value="merge fragments&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;below min_chunk_chars,&lt;br&gt;if they fit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-chunk-c3" target="page-chunk-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-chunk-c4" target="page-chunk-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-chunk-c5" target="page-chunk-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c10" value="&lt;b&gt;Chunk&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c&lt;br&gt;&lt;br&gt;HMB &amp;gt; Efficacy&lt;br&gt;&lt;br&gt;Although studies have investigated HMB for two decades, they have not produced clear evidence of benefit…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="525" height="150" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-chunk-c6" target="page-chunk-c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-c12" value="&lt;b&gt;the heading path is inside the chunk text&lt;/b&gt;&lt;br&gt;&lt;br&gt;“#### Efficacy” on its own is useless in an index. “HMB &amp;gt; Efficacy” tells both the embedder and the reader what the passage is about.&lt;br&gt;&lt;br&gt;The path is trimmed from the outside in — the document title is on every chunk and carries no information, so it is dropped whenever a deeper heading exists — and capped at max_section_chars so it can never crowd out the body." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="525" height="150" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-note13" value="&lt;b&gt;The size promise is kept.&lt;/b&gt; The heading path is subtracted from the budget before splitting, and merging a small fragment is skipped rather than allowed to push a chunk past the size you asked for — which is what the OVERSIZED flag on the Chunks tab checks." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="page-chunk-note14" value="&lt;b&gt;Content-derived ids.&lt;/b&gt; A chunk&#x27;s id is its index plus a hash of its text, so re-indexing the same document upserts the same rows instead of piling up duplicates — and an edited chunk cannot leave a stale copy behind." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="505" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-questions" name="6 · Step 4 — Questions">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-questions-t1" value="Hypothetical questions — giving the index something question-shaped" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-t2" value="QuestionGenerator · augmentation.py · optional (enable_questions)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-c3" value="288 chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-c4" value="ThreadPoolExecutor&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;question_workers · default 8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-c5" value="one generation call per chunk&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;temperature 0.3 · max_tokens 1024&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-c6" value="parse_lines()&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;strip bullets&lt;br&gt;and numbering&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="100" width="195" height="64" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-c7" value="{ chunk_id: [ “What is HMB?”, “Is HMB safe for older adults?”, … ] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="545" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-questions-c3" target="page-questions-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-questions-c4" target="page-questions-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-questions-c5" target="page-questions-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-questions-c6" target="page-questions-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-note12" value="&lt;b&gt;A chunk that fails is skipped, not fatal.&lt;/b&gt; The exception is logged and that chunk is simply indexed without questions." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-note13" value="&lt;b&gt;Why this exists.&lt;/b&gt; Users ask questions; documents are written as statements. The embedder has to bridge that gap on its own unless the index also contains text shaped like a question.&lt;br&gt;&lt;br&gt;Each question is stored as its own row pointing back at its parent chunk, so a question match resolves to the passage that answers it — see step 6." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="page-questions-note14" value="&lt;b&gt;This is the slow half of a build.&lt;/b&gt; 288 chunks × one call each ≈ 4 minutes on this machine, against about 8 seconds for all the embeddings.&lt;br&gt;&lt;br&gt;Reasoning tokens come out of max_tokens too: set it too low and a reasoning model spends the whole budget thinking and returns empty content, which LLMClient reports rather than passing off as a model with nothing to say." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="340" width="505" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-embed" name="7 · Step 5 — Embed">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-embed-t1" value="Embed — the same text scores differently on each side" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-t2" value="ServerEmbedder · embedding.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c3" value="chunk text&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;indexing a document&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c4" value="title: none | text: …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c5" value="your question&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;running a search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c6" value="task: search result | query: …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="200" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c7" value="batched&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;embed_batch_size&lt;br&gt;default 16 texts per call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-c8" value="unit-normalised&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;so cosine distance&lt;br&gt;behaves in Chroma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="100" width="215" height="160" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-embed-c3" target="page-embed-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-embed-c5" target="page-embed-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-embed-c4" target="page-embed-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-embed-c6" target="page-embed-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-embed-c7" target="page-embed-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-note14" value="&lt;b&gt;The model is asymmetric.&lt;/b&gt; EmbeddingGemma was trained with one instruction on the document side and another on the query side, and the /embeddings endpoint has no field for it — so the prefix is prepended here.&lt;br&gt;&lt;br&gt;Measured on a creatine query against a matching and a mismatched passage, the prefixes separated the two by &lt;b&gt;0.47&lt;/b&gt; against &lt;b&gt;0.35&lt;/b&gt; with none. Set both to &quot;&quot; for a symmetric model." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-note15" value="&lt;b&gt;The offline substitute.&lt;/b&gt; With the server switched off, HashEmbedder builds deterministic bag-of-words vectors instead. It only matches shared words, so retrieval quality drops a long way — but the UI, the CLI and the whole test suite run with nothing listening.&lt;br&gt;&lt;br&gt;Its vectors get their own collection, because vectors from different embedders are not comparable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="505" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-embed-note16" value="&lt;b&gt;If the server caps batch size&lt;/b&gt;, LLMClient halves the batch and retries rather than failing the build — a 400 whose message mentions a limit is treated as “too many”, and any other 400 is raised, because it will not fix itself." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1085" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-index" name="8 · Step 6 — Index">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-index-t1" value="Index — what a collection actually holds" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="page-index-t2" value="VectorIndex · indexing.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="page-index-c3" value="&lt;b&gt;chunk row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c&lt;br&gt;document: “HMB &amp;gt; Efficacy …”&lt;br&gt;type=chunk · parent_id=self · section · chunk_index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="page-index-c4" value="&lt;b&gt;question row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c-q0&lt;br&gt;document: “What is HMB?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-index-c5" value="&lt;b&gt;question row&lt;/b&gt;&amp;nbsp; c0042-1f3a9b7c-q1&lt;br&gt;document: “Is HMB safe for older adults?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-index-e6" value="parent_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="page-index-c4" target="page-index-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-index-e7" value="parent_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="page-index-c5" target="page-index-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-index-c8" value="&lt;b&gt;a pointer, not a copy&lt;/b&gt;&lt;br&gt;&lt;br&gt;A question row stores only its parent&#x27;s id. One copy of the document exists, and an edited chunk cannot leave a stale duplicate of its text behind. The Retriever resolves pointers to text in a single lookup at the end of a search." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="525" height="110" as="geometry" />
        </mxCell>
        <mxCell id="page-index-c9" value="&lt;b&gt;written in slices&lt;/b&gt;&lt;br&gt;&lt;br&gt;index_batch_size rows per upsert (default 100), so the embedding endpoint is never handed one enormous request. 288 chunks + 864 questions = &lt;b&gt;1,152 rows&lt;/b&gt; at the default settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="525" height="110" as="geometry" />
        </mxCell>
        <mxCell id="page-index-note10" value="&lt;b&gt;The collection name carries the recipe:&lt;/b&gt;&amp;nbsp; &lt;font face=&quot;Courier New&quot;&gt;ods_health_facts__embeddinggem_c600_o100_q3_m80_s1&lt;/font&gt;&lt;br&gt;embedder · chunk size · overlap · questions per chunk · merge threshold · heading prefix.&lt;br&gt;&lt;br&gt;Every parameter that changes the stored vectors is in the name, so moving a slider builds a &lt;i&gt;separate&lt;/i&gt; index instead of poisoning the one you have — and moving it back reuses what you already built. Settings with no room left in the name (the cleaning flags, the heading cap, the embedding prefixes) are hashed into an _x… suffix, which stays empty while they are all at their defaults so collections built before those knobs existed keep their names." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1085" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-expansion" name="9 · Step 7 — Expand">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
