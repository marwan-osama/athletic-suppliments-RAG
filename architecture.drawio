        <mxCell id="page-retrieve-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-retrieve-c7" target="page-retrieve-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-c14" value="&lt;b&gt;top-k chunks&lt;/b&gt; + similarity + score + what matched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="508" width="620" height="52" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="page-retrieve-c8" target="page-retrieve-c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-c16" value="&lt;b&gt;why collapse per chunk&lt;/b&gt;&lt;br&gt;&lt;br&gt;Without it, one passage fills every top-k slot through its own generated questions. dedupe_by_chunk folds a chunk and its questions into a single result; switched off, they stay separate and only genuinely repeated rows are dropped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-c17" value="&lt;b&gt;why over-fetch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Collapsing happens after the search, so asking Chroma for exactly top-k would leave fewer than k results once duplicates fold together. retrieval_overfetch (default 3) pulls k × 3 rows so there is something left to rank." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="page-retrieve-note18" value="&lt;b&gt;What comes back per hit&lt;/b&gt;&lt;br&gt;&lt;br&gt;chunk_id · section · text · match_type (chunk or question) · the question that matched, if it was one · similarity as the embedder returned it · matches and boost from expansion · score, which is what the ordering used.&lt;br&gt;&lt;br&gt;The Ask tab shows all of it, and the Review tab records it with your verdict." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="425" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
