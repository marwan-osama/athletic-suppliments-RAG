          <mxGeometry x="784" y="416" width="341" height="74" as="geometry" />
        </mxCell>
        <mxCell id="page-architecture-e21" value="fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;fontSize=11;exitX=0.15;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="page-architecture-c8" target="page-architecture-c18">
